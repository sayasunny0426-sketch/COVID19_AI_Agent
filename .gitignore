# data and imaging artefacts (never committed)
# NOTE: anchored with a leading slash. An unanchored `data/` also matches
# src/covid_mortality/data/, which is source code and must stay tracked.
/data/
results/**/images/
*.dcm
*.nii
*.nii.gz
*.png
# The approved Grad-CAM panel is the only patient imaging that is published.
!results/taskA/gradcam/*.png
# Task B distribution plots are aggregate Training summaries, not patient data, and they are
# the visual evidence for the log1p / transform decisions recorded in preprocess_spec.json.
!results/taskB/preprocessing/figures/*.png

# model artefacts
checkpoints/
*.pt
*.pth
*.ckpt
*.joblib
*.npy
*.npz

# environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.uv/
uv.lock

